+#[test]
+fn metadata_limit_counts_utf8_replacement_bytes() {
+    let original = jpeg(false, None);
+    let mut bytes = original[..2].to_vec();
+    marker(&mut bytes, 0xfe, &[0xff; 3]);
+    bytes.extend_from_slice(&original[2..]);
